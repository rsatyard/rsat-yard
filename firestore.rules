rules_version = '2';
// Only approved accounts can see or change tank records.
// Anyone may create a login, but it stays "pending" until an admin approves it in the app.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function myDoc() { return /databases/$(database)/documents/users/$(myEmail()); }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    function active() { return signedIn() && exists(myDoc()) && get(myDoc()).data.status == 'active'; }
    function isAdmin() { return active() && get(myDoc()).data.role == 'admin'; }
    function validProfile(d) {
      return d.keys().hasOnly(['email', 'name', 'role', 'status', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.role in ['admin', 'staff'] && d.status in ['pending', 'active', 'disabled'];
    }

    // Staff and admins record and change tanks; only admins can delete a tank record (and with it, its history).
    match /tanks/{tank} {
      allow read, create, update: if active();
      allow delete: if isAdmin();
    }

    match /users/{email} {
      allow get: if isAdmin() || (signedIn() && email == myEmail());
      allow list: if isAdmin();
      allow create: if validProfile(request.resource.data) && request.resource.data.email == email && (
        isAdmin()
        // A new login asks for access: its own record, pending, staff.
        || (signedIn() && email == myEmail()
            && request.resource.data.status == 'pending' && request.resource.data.role == 'staff')
        // First-time setup: the first person to claim the app becomes its admin.
        || (signedIn() && email == myEmail() && !exists(ownerDoc())
            && getAfter(ownerDoc()).data.email == myEmail()
            && request.resource.data.status == 'active' && request.resource.data.role == 'admin')
      );
      // Admins manage everyone except themselves and the owner, so nobody locks the app out.
      allow update: if isAdmin() && email != myEmail() && validProfile(request.resource.data)
        && request.resource.data.email == email && email != get(ownerDoc()).data.email;
      allow delete: if isAdmin() && email != myEmail() && email != get(ownerDoc()).data.email;
    }

    // Open spaces per slot (id = slot code, e.g. A10). Everyone signed in reads; only admins open or close spaces.
    match /slots/{code} {
      allow read: if active();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['code', 'open', 'updatedAt', 'updatedBy'])
        && request.resource.data.code == code
        && request.resource.data.open is int && request.resource.data.open >= 0 && request.resource.data.open <= 5;
      allow delete: if isAdmin();
    }

    // A request for more space in a slot (one per slot, 1-5 spaces). Staff ask; only admins approve (by opening spaces) or reject.
    match /slotRequests/{code} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['code', 'by', 'name', 'at', 'spaces'])
        && request.resource.data.code == code && request.resource.data.by == myEmail()
        && request.resource.data.spaces is int && request.resource.data.spaces >= 1 && request.resource.data.spaces <= 5;
      allow delete: if isAdmin() || (active() && resource.data.by == myEmail());
    }

    // Team chat. Everyone approved reads and posts as themselves; messages can't be edited.
    // People delete their own messages; admins delete any.
    // A message has text, a photo, or both. With a photo it holds a small preview (thumb) and the id of the bigger copy.
    match /chat/{id} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['text', 'by', 'name', 'at', 'thumb', 'photo'])
        && request.resource.data.by == myEmail()
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && (request.resource.data.text.size() > 0 || 'thumb' in request.resource.data)
        && (!('thumb' in request.resource.data) || (request.resource.data.thumb is string && request.resource.data.thumb.size() <= 80000));
      allow delete: if isAdmin() || (active() && resource.data.by == myEmail());
    }

    // The bigger copy of a chat photo (shrunk on the phone first, well under the 1 MB record limit).
    match /chatPhotos/{id} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['data', 'by', 'at'])
        && request.resource.data.by == myEmail()
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000;
      allow delete: if isAdmin() || (active() && resource.data.by == myEmail());
    }

    // "Forgot password" requests (id = email). Anyone may ask, even signed out, but nobody can read the list
    // except admins. An admin approves by sending the reset email from Accounts, which also clears the request.
    match /resetRequests/{email} {
      allow get, list, delete: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email == email
        && email is string && email.size() <= 100 && email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && request.resource.data.at is string && request.resource.data.at.size() <= 40;
    }

    // Oldest phone-app build allowed (set by admins under Accounts).
    match /config/app {
      allow get: if signedIn();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['minBuild', 'updatedAt', 'updatedBy'])
        && request.resource.data.minBuild is int && request.resource.data.minBuild >= 0;
    }

    match /config/owner {
      allow get: if signedIn();
      allow create: if signedIn() && !exists(ownerDoc())
        && request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email == myEmail()
        && getAfter(myDoc()).data.role == 'admin';
    }
  }
}
